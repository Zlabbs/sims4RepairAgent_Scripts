<script>
	<title>Wont start (cache clear)</title>
	<desc>Destroys bad cache files.</desc>

	<needsAdmin>false</needsAdmin>
	<needsAdminFromAgent>false</needsAdminFromAgent> 	
	<autoCheckScript></autoCheckScript> 
	<runScript>something_else.bat</runScript>
	
	<searchTags_Helpful>start,cache,</searchTags_Helpful>
	<searchTags_Required></searchTags_Required>
</script>

<script>
	<title>Wont start (mod corruption)</title>
	<desc>Moves the mods from the game and if that fixes the issue you can make the move a delete</desc>

	<needsAdmin>false</needsAdmin>
	<needsAdminFromAgent>false</needsAdminFromAgent> 
	<autoCheckScript></autoCheckScript> 
	<runScript>something_else.bat</runScript>
	
	<searchTags_Helpful>start,corruption,</searchTags_Helpful>
	<searchTags_Required></searchTags_Required>
</script>

<script>
	<title>Blocked from running.</title>
	<desc>Is blocked from running by windows.</desc>

	<needsAdmin>true</needsAdmin>
	<needsAdminFromAgent>false</needsAdminFromAgent> 
	<autoCheckScript>BlockByWindows_auto.vbs</autoCheckScript> 
	<runScript>BlockByWindows_run.vbs</runScript>
	
	<searchTags_Helpful>windows,</searchTags_Helpful>
	<searchTags_Required>blocked,</searchTags_Required>
</script>