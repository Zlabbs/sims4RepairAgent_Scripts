//master list of all the fixes in stack engine flavour xml

<donateWebLink>https://zlabbsweb.github.io/donations/S4RA/</donateWebLink>

<script>
	<title>Wont start (cache clear)</title>
	<desc>Destroys bad cache files.</desc>

	<needsAdmin>false</needsAdmin>
	<needsAdminFromAgent>false</needsAdminFromAgent> 	
	<autoCheckScript></autoCheckScript> 
	<runScript>something_else.bat</runScript>
	
	<searchTags_Helpful>start,cache,</searchTags_Helpful>
	<searchTags_Required></searchTags_Required>
</script>

<script>
	<title>Wont start (mod corruption)</title>
	<desc>Moves the mods from the game and if that fixes the issue you can make the move a delete</desc>

	<needsAdmin>false</needsAdmin>
	<needsAdminFromAgent>false</needsAdminFromAgent> 
	<autoCheckScript></autoCheckScript> 
	<runScript>something_else.bat</runScript>
	
	<searchTags_Helpful>start,corruption,</searchTags_Helpful>
	<searchTags_Required></searchTags_Required>
</script>

<script>
	<title>Wont start (save bricked)</title>
	<desc>Moves the saves from the game and if that works it will revert it and delete it if that dosent work.</desc>

	<needsAdmin>false</needsAdmin>
	<needsAdminFromAgent>false</needsAdminFromAgent> 
	<autoCheckScript></autoCheckScript> 
	<runScript>something_else.bat</runScript>
	
	<searchTags_Helpful>start,corruption,</searchTags_Helpful>
	<searchTags_Required></searchTags_Required>
</script>

<script>
	<title>Blocked by smart app control.</title>
	<desc>Is blocked from running by smart app control.</desc>

	<needsAdmin>true</needsAdmin>
	<needsAdminFromAgent>false</needsAdminFromAgent> 
	<autoCheckScript>BlockBySmartAppControl_auto.vbs</autoCheckScript> 
	<runScript>BlockBySmartAppControl_run.vbs</runScript>
	
	<searchTags_Helpful>windows,smart,</searchTags_Helpful>
	<searchTags_Required>blocked,</searchTags_Required>
</script>
