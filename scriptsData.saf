<script>
	<title>Blocked by smart app control.</title>
	<desc>Is blocked from running by smart app control.</desc>

	<needsAdmin>true</needsAdmin>
	<needsAdminFromAgent>false</needsAdminFromAgent> 
	<autoCheckScript>BlockBySmartAppControl_auto.vbs</autoCheckScript> 
	<runScript>BlockBySmartAppControl_run.vbs</runScript>
	
	<searchTags_Helpful>windows,smart,</searchTags_Helpful>
	<searchTags_Required>blocked,</searchTags_Required>
</script>

